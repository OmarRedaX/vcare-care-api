{
  "name": "care-service",
  "version": "0.1.0",
  "private": true,
  "description": "vcare Care service — doctors, scheduling, consultations, and the clinical record",
  "type": "commonjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest -c jest.config.js",
    "test:integration": "jest -c jest.integration.config.js --runInBand",
    "test:infra:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:infra:down": "docker compose -f docker-compose.test.yml down -v",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts latest",
    "migrate:rollback": "tsx --env-file-if-exists=.env src/migrate.ts rollback",
    "migrate:status": "tsx --env-file-if-exists=.env src/migrate.ts status",
    "migrate:make": "tsx --env-file-if-exists=.env src/migrate.ts make"
  },
  "dependencies": {
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "knex": "3.3.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "tsyringe": "4.10.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "jest": "30.5.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
