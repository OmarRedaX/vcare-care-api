# Template for .env.test (committed). cp .env.test.example .env.test
# Synthetic, local-only test values. Real environment variables always win over .env.test (tests/setup-env.ts).
# Targets docker-compose.test.yml (npm run test:infra:up): Postgres 5434, Redis 6381.
NODE_ENV=test
PORT=3001
INTERNAL_PORT=3101
# Owner (migrations, test setup/teardown, grant assertions) and app login (the code under test) — ADR 0018.
MIGRATION_DATABASE_URL=postgres://care:care@localhost:5434/care_test
DATABASE_URL=postgres://care_app:care_app@localhost:5434/care_test
REDIS_URL=redis://localhost:6381/0
# Unreachable placeholder: suites that need keys override the JWKS cache with a fake JWKS server.
IDENTITY_JWKS_URL=http://127.0.0.1:1/.well-known/jwks.json
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=warn
SHUTDOWN_TIMEOUT_MS=2000
