# Synthetic, local-only test values (committed). Real environment variables always win over this file.
# Targets docker-compose.test.yml (npm run test:infra:up): Postgres 5434, Redis 6381.
# Ports avoid the dev stack (5433/6380) and identity-service (5432/6379 dev, 5435/6382 test).
NODE_ENV=test
PORT=3001
INTERNAL_PORT=3101
DATABASE_URL=postgres://care:care@localhost:5434/care_test
REDIS_URL=redis://localhost:6381/0
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=warn
SHUTDOWN_TIMEOUT_MS=2000
