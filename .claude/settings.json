{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git worktree list*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx tsc *)",
      "Bash(npx jest *)",
      "Bash(npx -y @redocly/cli lint *)",
      "Bash(curl -s http://localhost*)",
      "Bash(curl -s -o /dev/null -w * http://localhost*)",
      "Read(../vcare-hub/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/docs-sync-check.sh\"",
            "timeout": 60,
            "statusMessage": "Checking vcare docs sync across repos..."
          }
        ]
      }
    ]
  }
}
