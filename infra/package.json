{
  "name": "care-storage-infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK app for care-service's private object-storage bucket (hub ADR 0011, care ADR 0029). Separate from the service package on purpose: nothing here ships in the care image.",
  "engines": { "node": ">=24" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node node_modules/jest/bin/jest.js -c jest.config.js",
    "synth": "cdk synth --strict",
    "diff": "cdk diff",
    "deploy": "cdk deploy"
  },
  "dependencies": {
    "aws-cdk-lib": "2.277.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.13.5",
    "aws-cdk": "2.1148.1",
    "jest": "30.5.1",
    "ts-jest": "29.4.12",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
