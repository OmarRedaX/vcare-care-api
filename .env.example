# vcare care-service — local environment (synthetic values only).
# Local development against docker-compose.yml infrastructure, app on the host: cp .env.example .env
# Every variable is declared in src/lib/config/env.ts (CLAUDE.md -> Security rules).
# Secrets have no defaults; never commit a real value.

NODE_ENV=development

# Public listener (/api) and internal listener (/internal). One above identity-service (3000/3100).
PORT=3001
INTERNAL_PORT=3101
# Bind address of the internal listener. Use 0.0.0.0 inside a container, 127.0.0.1 on a host.
INTERNAL_HOST=127.0.0.1
# Number of trusted proxy hops in front of the public listener (0 = no proxy).
TRUST_PROXY_HOPS=0

# SECRET — PostgreSQL OWNER connection string (compose dev stack on host port 5433). Used only by the migrate
# commands (npm run migrate, npm run migrate:ensure-app-login); care-api and care-worker never need it (ADR 0018).
MIGRATION_DATABASE_URL=postgres://care:care@localhost:5433/care
# SECRET — PostgreSQL APP login (care_app, member of the NOLOGIN group role vcare_app) used by care-api and
# care-worker. Created/updated from this URL by `npm run migrate:ensure-app-login`. Must name a different role.
DATABASE_URL=postgres://care_app:care_app@localhost:5433/care
DATABASE_POOL_MAX=20

# SECRET — Redis connection string (compose dev stack on host port 6380; Tier 2: an outage never fails a request).
REDIS_URL=redis://localhost:6380

# Identity's public JWKS (user-token verification keys). Point it at wherever the local identity-service public
# listener runs. No default: a wrong value would answer 401 to every authenticated request.
IDENTITY_JWKS_URL=http://localhost:3000/.well-known/jwks.json
IDENTITY_INTERNAL_URL=http://localhost:3100
SERVICE_CLIENT_ID=care-local-synthetic
SERVICE_CLIENT_SECRET=synthetic-local-service-secret

# Private local MinIO bucket; credentials are synthetic and local only.
STORAGE_BUCKET=care-private
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9002
STORAGE_ACCESS_KEY_ID=care-local
STORAGE_SECRET_ACCESS_KEY=synthetic-minio-secret
STORAGE_FORCE_PATH_STYLE=true
UPLOAD_POLICY_TTL_SECONDS=300
UPLOAD_INTENT_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=60
IDENTITY_SYNC_POLL_SECONDS=10
IDENTITY_SYNC_RETRY_CAP_SECONDS=60
IDENTITY_SYNC_ALERT_AFTER_SECONDS=900
UPLOAD_INTENT_PURGE_SECONDS=300

# Notification delivery (care-worker, ADR 0011): outbox poll, claim batch, attempts before dead, sent-row retention (days), purge and reminder-scan cadence.
OUTBOX_POLL_SECONDS=5
# OUTBOX_BATCH_SIZE is 1..59: batch x 5 s send timeout + 2 s must stay below the 300 s claim lease.
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETENTION_DAYS=30
OUTBOX_PURGE_SECONDS=3600
REMINDER_SCAN_SECONDS=60

# Booking rules (Domain rules 3 and 10): furthest bookable start in days, and the patient cancel/reschedule window in minutes.
BOOKING_HORIZON_DAYS=60
CANCELLATION_POLICY_MINUTES=120

# Availability (slots): TTL in seconds of a cached slot list in Redis (derived data, 1..60; the slots-ver key invalidates it sooner on any change).
SLOT_CACHE_TTL_SECONDS=60
# Availability worker (ADR 0024/0025): seconds between full rank-index sweeps, seconds between name-index rebuilds (slice 3), and the cap of doctors a search request computes inline on an index miss (0..100).
AVAILABILITY_SWEEP_INTERVAL_SECONDS=120
AVAILABILITY_NAME_REFRESH_SECONDS=300
AVAILABILITY_INLINE_MISS_CAP=20

# Sessions (Domain rules 11 and 12): minutes the room opens before the start, stays open after the end, and the no-show grace after the start.
NO_SHOW_GRACE_MINUTES=10
WAITING_ROOM_OPEN_MINUTES=10
SESSION_OVERRUN_MINUTES=15
# Video room provider behind lib/video. Only the deterministic fake exists; it is refused when NODE_ENV=production.
VIDEO_PROVIDER=fake
# SECRET (>= 32 chars) — signs the fake provider join tokens. No default.
VIDEO_PROVIDER_KEY=synthetic-video-provider-key-0123456789abcdef
VIDEO_JOIN_TOKEN_TTL_SECONDS=300

# care-worker: monthly audit_logs partitions kept ahead of the current UTC month (1..12, ADR 0009).
AUDIT_PARTITION_MONTHS_AHEAD=2

# Development only; production is a single origin with CORS disabled (hub ADR 0005).
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
RATE_LIMIT_FALLBACK_DIVISOR=2
WORKER_POLL_INTERVAL_MS=1000

# Allowed consultation fee currencies (comma-separated ISO-4217 codes).
ALLOWED_CURRENCIES=EGP
